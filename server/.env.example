# Server
PORT=5000
MONGO_URI=mongodb://localhost:27017/pizzaria
JWT_SECRET=supersecretjwtkey_change_me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Admin seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@pizzaria.local
ADMIN_PASSWORD=Admin@123

# Razorpay (test mode - optional, app works in mock mode without them)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_MOCK=true

# SMTP / Nodemailer (use Ethereal or any SMTP; if empty, links are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pizzaria <no-reply@pizzaria.local>
ADMIN_ALERT_EMAIL=admin@pizzaria.local

# Cron (every 10 minutes by default)
STOCK_CRON_SCHEDULE=*/10 * * * *
STOCK_ALERT_COOLDOWN_MIN=60
